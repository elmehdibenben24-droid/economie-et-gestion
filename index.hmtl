<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بنك 200 سؤال - مدخل إلى علم الاقتصاد</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 font-sans min-h-screen p-4 md:p-8 flex items-center justify-center">
    <div class="max-w-3xl w-full bg-slate-800 rounded-2xl shadow-2xl p-6 md:p-8 border border-slate-700">
        <header class="border-b border-slate-700 pb-4 mb-6 text-center">
            <h1 class="text-2xl font-bold text-amber-400">بنك الـ 200 سؤال الشامل - علم الاقتصاد</h1>
            <p class="text-sm text-slate-400 mt-1">التحضير للامتحانات الجامعية (أسئلة متعددة الاختيارات QCM)</p>
        </header>

        <div id="quiz-container">
            <div class="flex justify-between items-center mb-4">
                <span id="q-number" class="text-xs font-semibold bg-amber-900 text-amber-300 px-3 py-1 rounded-full">السؤال 1 من 200</span>
                <span id="progress-text" class="text-xs text-slate-400 font-medium">التقدم: 0.5%</span>
            </div>
            
            <div id="question-box" class="mb-6">
                <h2 id="q-text" class="text-lg font-medium text-white leading-relaxed"></h2>
            </div>

            <div id="options-box" class="space-y-3 mb-6"></div>

            <div class="flex justify-between items-center border-t border-slate-700 pt-4">
                <span id="score-display" class="font-semibold text-amber-400">النتيجة الصحيحة: 0</span>
                <button id="next-btn" onclick="nextQuestion()" class="bg-amber-600 hover:bg-amber-500 text-white font-medium px-6 py-2 rounded-xl transition hidden">السؤال الموالي</button>
            </div>
        </div>

        <div id="result-box" class="hidden text-center py-8">
            <h2 class="text-2xl font-bold text-white mb-2">أهلاً بك أخي المهدي، أنهيت الـ 200 سؤال بنجاح تام!</h2>
            <p id="final-score" class="text-lg text-slate-300 mb-6"></p>
            <button onclick="restartQuiz()" class="bg-amber-600 hover:bg-amber-500 text-white font-medium px-6 py-2 rounded-xl">إعادة الاختبار</button>
        </div>
    </div>

    <script>
        // قاعدة البيانات الأساسية المستخلصة مباشرة من ملخص علم الاقتصاد
        const coreQuestions = [
            {
                q: "ما هو التعريف الأساسي لعلم الاقتصاد حسب ما ورد في المقرر؟",
                o: ["العلم الذي يهتم بتدبير الموارد النادرة واستعمالها للحصول على أكبر إشباع وفهم الواقع المادي المعاش", "علم جمع الضرائب وتمويل ميزانية الدولة فقط", "دراسة سلوك الحيوانات البرية وتوزيع الغذاء", "علم تخطيط المدن الكبرى وهندستها المعمارية"],
                c: 0
            },
            {
                q: "من هو أول من استعمل تعبير 'الاقتصاد السياسي' ليدل على العلم الذي يدبر الثروة؟",
                o: ["آدم سميث", "أنطوان دي مونكريتيان", "جون ماينارد كينز", "كارل ماركس"],
                c: 0
            },
            {
                q: "في أي سنة نشر آدم سميث كتابه الشهير 'دراسة في طبيعة وأسباب ثروة الأمم'؟",
                o: ["1766", "1929", "1857", "1950"],
                c: 0
            },
            {
                q: "ما هو الفارق الأساسي بين علم الاقتصاد والسياسة الاقتصادية؟",
                o: ["الاقتصاد يفسر الظواهر الاقتصادية ويحللها، بينما السياسة الاقتصادية تقدم النصح فيما يجب أن يكون عليه الوضع", "الاقتصاد هو السياسة نفسها بدون أي اختلاف", "السياسة الاقتصادية تدرس التاريخ فقط", "الاقتصاد يهتم بالقانون الجنائي والسياسة بالقانون المدني"],
                c: 0
            },
            {
                q: "ما هي الأسباب الرئيسية لنشوء ودواعي علم الاقتصاد؟",
                o: ["ارتباطه بالإنسان والمجتمع للكشف عن القوانين، تدخل الدولة، والتباين في مستويات التقدم بين الدول", "القضاء على جميع الموارد الحرة في الطبيعة", "منع التبادل التجاري الدولي كلياً", "إلغاء العملات النقدية والعودة للمقايضة الدائمة"],
                c: 0
            },
            {
                q: "ما هي خصائص الظاهرة الاقتصادية حسب النص؟",
                o: ["ظاهرة اجتماعية تجري في الزمن، ظاهرة متقطعة، ولصيقة بالإنسان وتتطلب تحليل دوافعه", "ظاهرة طبيعية بحتة لا تدخل للإنسان فيها كغليان الماء", "ظاهرة ثابتة لا تتغير عبر التاريخ مطلقاً", "ظاهرة رياضية بحتة تطبق في المختبرات الكيميائية"],
                c: 0
            },
            {
                q: "ما هو الفرق بين التحليل الاقتصادي الجزئي والتحليل الكلي؟",
                o: ["الجزئي يتناول السلوك الاقتصادي على مستوى الوحدة (الاستهلاك والفرد)، بينما الكلي يدرس المجاميع الكبرى (الدخل والتشغيل)", "الجزئي يدرس اقتصاد العالم بأسره والكلي يدرس الأسرة وحدها", "لا يوجد أي فرق بينهما فدراسة شجرة هي نفس دراسة غابة", "الجزئي يهتم بالبطالة والكلي يهتم بأسعار السجائر"],
                c: 0
            },
            {
                q: "من هو صاحب فكرة 'التحليل القطاعي' للمجموعات الصناعية الكبرى سنة 1975؟",
                o: ["ستوارت هولاند", "فرانسوا كينيه", "ألفرد مارشال", "دافيد ريكاردو"],
                c: 0
            },
            {
                q: "ما هي الفكرة الأساسية للمدرسة التجارية (الميركونتيلية)؟",
                o: ["أن ثروة البلد تتمثل فيما يملكه من ذهب وفضة وغاية النظام الاقتصادي تحقيق قوة الدولة", "الاعتماد المطلق على الزراعة وحدها باعتبارها المصدر الوحيد للثروة", "إلغاء التجارة الخارجية ومنع الاستيراد والتصدير", "تحقيق الشيوعية والمساواة المطلقة بين العمال"],
                c: 0
            },
            {
                q: "ما هو الشعار الأساسي للمذهب الطبيعي أو الفيزوقراطي؟",
                o: ["دعه يعمل، دعه يمر", "يا عمال العالم استهدوا", "الأرض للجميع بدون قيود", "الدولة هي كل شيء وليس خارجها شيء"],
                c: 0
            },
            {
                q: "على ماذا تستند فرضية آدم سميث في المدرسة الكلاسيكية؟",
                o: ["المصلحة الفردية هي الدافع لأي نشاط اقتصادي وأن 'اليد الخفية' للسوق تحل المشكلات بعيداً عن تدخل الدولة", "وجوب تدخل الدولة في كل صغيرة وكبيرة في الإنتاج", "إلغاء الملكية الخاصة لوسائل الإنتاج", "الاعتماد حصراً على المقايضة الزراعية"],
                c: 0
            },
            {
                q: "ما هو الأساس الذي يقوم عليه الاقتصاد الماركسي في تحديد قيمة السلعة؟",
                o: ["عدد ساعات العمل الضروري لإنتاجها، وأن أساس القيمة ومصدرها هو العمل", "المنفعة الحدية للمستهلك في السوق الحر", "كمية الذهب والفضة التي تملكها الخزينة", "مزاج المستهلك ورغبته اللحظية"],
                c: 0
            },
